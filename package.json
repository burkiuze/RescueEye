{
  "name": "rescueeye",
  "version": "1.0.0",
  "description": "AI-Powered Search & Rescue UAV Platform",
  "main": "backend/server.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node dist/backend/main.js",
    "dev": "node scripts/build.js && node dist/backend/main.js",
    "test": "node node_modules/jest/bin/jest.js --runInBand --no-coverage",
    "test:coverage": "node node_modules/jest/bin/jest.js --runInBand --coverage",
    "check:mermaid": "node scripts/check-mermaid.js"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
